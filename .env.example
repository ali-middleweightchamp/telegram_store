# Токен бота. Получить: @BotFather → /newbot (или /token для существующего)
BOT_TOKEN=1234567890:AAH-ваш-токен-здесь

# Telegram ID админов через запятую, без пробелов. Свой ID: @userinfobot
ADMIN_IDS=111111111,222222222

# Необязательно. ID закрытого канала для ежедневной копии базы этого магазина.
# Бот должен быть админом канала. ID канала начинается с -100. Пусто = бэкапы выключены
BACKUP_CHAT_ID=

# Необязательно. ID группы заказов с включёнными темами.
# Бот должен быть админом группы с правом управлять темами. Пусто = заказы в личку админам
ORDERS_CHAT_ID=

# Папка с данными магазина: база, фото, shop.json. Путь от корня проекта
DATA_DIR=data

# Подробность логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Необязательно. ID Google Таблицы (часть адреса между /d/ и /edit). Пусто = выключено
GOOGLE_SHEET_ID=

# Необязательно. Имя JSON-ключа сервисного аккаунта Google в папке DATA_DIR
GOOGLE_CREDENTIALS_FILE=google.json